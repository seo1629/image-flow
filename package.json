{
  "name": "modular-image-flow",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "postinstall": "npm install --prefix server",
    "build": "vite",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@xyflow/react": "latest",
    "zustand": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
